generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// Scheduly schema alineado a EdDeli (misma estructura de campos)
// Nombres semánticos (sin prefijo Inventory*). Agenda/Servicios = extras.
// ============================================================

enum ProductType {
  raw
  intermediate
  final
}

enum StockMovementType {
  entrada
  salida
  ajuste
  produccion
}

enum SaleStatus {
  pendiente
  entregado
  pagado
}

enum PurchaseOrderStatus {
  pendiente
  recibido
  cancelado
}

enum CashShiftStatus {
  open
  closed
}

enum BranchLocationKind {
  propia
  vitrina
  bodega
}

enum RecipeItemType {
  insumo
  material
}

enum BatchStatus {
  active
  depleted
}

enum FinanceStatus {
  pending
  paid
}

enum PaymentStatus {
  completed
  cancelled
}

enum EntitlementStatus {
  gestor_push
  gestor_pull
}

enum AppointmentStatus {
  scheduled
  rescheduled
  paid_pending
  pending_payment
  completed
  cancelled
}

enum TaskItemStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskItemPriority {
  low
  medium
  high
}

enum ElectronicInvoiceStatus {
  draft
  signed
  received
  authorized
  rejected
  cancelled
}

enum NotificationType {
  info
  alert
  reminder
  message
}

// ——— Identidad (EdDeli: Roles, Users, Account, AccountRoles, UserData) ———

model Role {
  id   Int     @id @default(autoincrement())
  name String?

  accountRoles AccountRole[]
}

/** Persona física (EdDeli Users). Login vive en Account (1:1). */
model Person {
  id             Int       @id @default(autoincrement())
  ci             String?   @unique
  documentType   String?
  firstName      String?
  secondName     String?
  firstLastName  String?
  secondLastName String?
  birthday       DateTime? @db.Date
  gender         String?
  photo          String?   @db.Text

  /** Una persona → una sola cuenta de acceso. */
  account       Account?
  personData    PersonData?
  notifications Notification[]
  cashShifts    CashShift[]
  cashShiftMovements CashShiftMovement[]
  taskItemsAssigned TaskItem[] @relation("TaskAssignee")
  taskItemsChecked  TaskItem[] @relation("TaskChecker")
  appointments  Appointment[] @relation("AppointmentStaff")
}

/** Cuenta de acceso (EdDeli Account). Puede tener varios roles. */
model Account {
  id       Int     @id @default(autoincrement())
  username String? @unique
  password String?
  /** FK 1:1 con Person: un usuario solo puede tener una cuenta. */
  userId   Int?    @unique
  isActive Boolean @default(true)

  person Person? @relation(fields: [userId], references: [id])
  roles  AccountRole[]
  branches AccountBranch[]

  stockMovementsCreated StockMovement[] @relation("MovementCreator")
  batchesCreated        Batch[]         @relation("BatchCreator")
  branchesCreated       Branch[]        @relation("BranchCreator")
  branchesManaged       Branch[]        @relation("BranchManager")
  expensesCreated       Expense[]       @relation("ExpenseCreator")
  incomesCreated        Income[]        @relation("IncomeCreator")
  salesSold             Sale[]          @relation("SaleSeller")
  paymentsCreated       FinancePayment[] @relation("PaymentCreator")
  cashClosesCreated     CashClose[]      @relation("CashCloseCreator")
  payrollWeeksCreated   PayrollWeek[]    @relation("PayrollWeekCreator")
  payrollWeekLines      PayrollWeekLine[] @relation("PayrollWeekLineEmployee")
}

/** Vincula una cuenta a uno o más locales. isPrimary = local que administra/trabaja. */
model AccountBranch {
  id        Int     @id @default(autoincrement())
  accountId Int
  branchId  Int
  isPrimary Boolean @default(true)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([accountId, branchId])
  @@index([accountId, isPrimary])
  @@index([branchId])
}

model AccountRole {
  id        Int @id @default(autoincrement())
  accountId Int
  roleId    Int

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountId, roleId])
  @@index([roleId])
}

/** Datos de contacto de la persona (EdDeli UserData). */
model PersonData {
  id                 Int     @id @default(autoincrement())
  idUser             Int     @unique
  direction          String? @db.VarChar(250)
  placeResidence     String? @db.VarChar(150)
  phone              String? @db.VarChar(20)
  cellPhone          String? @db.VarChar(20)
  bloodType          String? @db.VarChar(10)
  personalEmail      String? @db.VarChar(120)
  institutionalEmail String? @db.VarChar(120)

  person Person @relation(fields: [idUser], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(info)
  title     String?          @db.VarChar(255)
  message   String?          @db.Text
  link      String?          @db.VarChar(255)
  sourceKey String?          @db.VarChar(120)
  deleted   Boolean          @default(false)
  seen      Boolean          @default(false)
  createdAt DateTime         @default(now())

  person Person @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seen])
  @@index([userId, createdAt])
}

model NotificationProgram {
  id                      Int       @id @default(autoincrement())
  code                    String    @unique @db.VarChar(64)
  title                   String?
  message                 String?   @db.Text
  link                    String?
  notificationType        String?   @default("info")
  scheduleType            String?   @default("manual")
  scheduleTime            String?
  scheduleIntervalMinutes Int?
  scopeType               String?   @default("user")
  targetType              String?
  targetRoleIds           Json?
  handlerType             String?   @default("static")
  active                  Boolean   @default(true)
  lastRunAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  dispatches NotificationDispatchLog[]
}

model NotificationDispatchLog {
  id           Int      @id @default(autoincrement())
  programId    Int
  userId       Int
  dispatchDate DateTime @db.Date
  createdAt    DateTime @default(now())

  program NotificationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, userId, dispatchDate])
}

// ——— Catálogo / stock (EdDeli Inventory*) ———

model Category {
  id                 Int     @id @default(autoincrement())
  name               String
  description        String? @db.Text
  isPublic           Boolean @default(true)
  packageTiers       Json?
  mixMatchLabel      String? @db.VarChar(120)
  mixMatchProductIds Json?
  parentId           Int?
  /** Comisión % por defecto para productos de la categoría (si el producto no define la suya). */
  commissionPct      Float   @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  pricingTierGroups PricingTierGroup[]
}

model Unit {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  abbreviation String
  description  String?
  factor       Float   @default(0)

  products Product[]
}

model Product {
  id                   Int         @id @default(autoincrement())
  name                 String      @db.VarChar(150)
  desc                 String?     @db.Text
  type                 ProductType @default(raw)
  unitId               Int
  categoryId           Int?
  standardWeightGrams  Float       @default(0)
  netWeight            Float       @default(0)
  stock                Float       @default(0)
  minStock             Float       @default(0)
  price                Float       @default(0)
  /** Comisión % venta producto (0 = hereda de categoría). */
  commissionPct        Float       @default(0)
  supplierPrice        Float       @default(0)
  wholesaleRules       Json?
  packageTiers         Json?
  distributorPrice     Float       @default(0)
  taxRate              Float       @default(0)
  sku                  String?     @unique @db.VarChar(64)
  barcode              String?     @unique @db.VarChar(64)
  isActive             Boolean     @default(true)
  primaryImageUrl      String?     @db.VarChar(500)
  isGenericIngredient  Boolean     @default(false)
  genericProductId     Int?
  unitsPerPack         Int?
  purchasePresentation String?     @db.VarChar(200)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  unit       Unit      @relation(fields: [unitId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  genericOf  Product?  @relation("GenericPresentations", fields: [genericProductId], references: [id])
  presentations Product[] @relation("GenericPresentations")

  recipesAsFinal Recipe[] @relation("RecipeFinal")
  recipesAsRaw   Recipe[] @relation("RecipeRaw")
  movements      StockMovement[]
  batches        Batch[]
  branchStocks   BranchStock[]
  branchProducts BranchProduct[]
  saleLines      SaleLine[]
  purchaseLines  PurchaseOrderLine[]
  homeProducts   HomeProduct[]
  catalogEntries CatalogEntry[]
  appointmentProducts AppointmentProduct[]
  rewards        Reward[]

  @@index([categoryId])
  @@index([type])
  @@index([isActive])
}

model Recipe {
  id                Int            @id @default(autoincrement())
  productFinalId    Int
  productRawId      Int
  quantity          Float
  isQuantityInGrams Boolean        @default(false)
  itemType          RecipeItemType @default(insumo)

  productFinal Product @relation("RecipeFinal", fields: [productFinalId], references: [id])
  productRaw   Product @relation("RecipeRaw", fields: [productRawId], references: [id])

  @@index([productFinalId])
  @@index([productRawId])
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  productId     Int
  quantity      Float
  description   String?           @db.Text
  price         Float?
  type          StockMovementType
  reason        String?
  referenceType String?
  referenceId   Int?
  date          DateTime          @default(now())
  createdBy     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  product Product @relation(fields: [productId], references: [id])
  creator Account @relation("MovementCreator", fields: [createdBy], references: [id])

  @@index([productId, date])
  @@index([type, date])
}

model Batch {
  id               Int         @id @default(autoincrement())
  productId        Int
  storeId          Int?
  code             String?
  quantityInitial  Float       @default(0)
  quantityRemaining Float      @default(0)
  expiresAt        DateTime?   @db.Date
  manufacturedAt   DateTime?   @db.Date
  receivedAt       DateTime?
  notes            String?     @db.Text
  status           BatchStatus @default(active)
  createdBy        Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  creator Account? @relation("BatchCreator", fields: [createdBy], references: [id])

  @@index([productId, status])
  @@index([storeId])
}

// ——— Locales / caja (EdDeli Store*) ———

model Branch {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(120)
  address            String             @db.VarChar(250)
  description        String?            @db.Text
  imageUrl           String?            @db.VarChar(500)
  phone              String?            @db.VarChar(40)
  email              String?            @db.VarChar(120)
  city               String?            @db.VarChar(100)
  province           String?            @db.VarChar(100)
  latitude           Float?
  longitude          Float?
  position           Int                @default(0)
  isActive           Boolean            @default(true)
  isVisible          Boolean            @default(true)
  locationKind       BranchLocationKind @default(vitrina)
  establishmentCode  String             @default("001") @db.VarChar(3)
  emissionPointCode  String             @default("001") @db.VarChar(3)
  /** Cuenta encargada principal de este local (puede haber más admins vinculados). */
  managerAccountId   Int?
  createdBy          Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  creator        Account?         @relation("BranchCreator", fields: [createdBy], references: [id])
  manager        Account?         @relation("BranchManager", fields: [managerAccountId], references: [id], onDelete: SetNull)
  accountBranches AccountBranch[]
  cashRegisters  CashRegister[]
  shelves        BranchShelf[]
  stocks         BranchStock[]
  products       BranchProduct[]
  cashShifts     CashShift[]
  batches        Batch[]
  salesDelivered SaleLine[]       @relation("SaleLineDeliveredBranch")
  purchaseOrders PurchaseOrder[]  @relation("PurchaseReceivedBranch")
  recurringTemplates RecurringExpenseTemplate[]
  appointments   Appointment[]
  serviceBranches ServiceBranch[]
  electronicInvoices ElectronicInvoice[]
  cashCloses     CashClose[]
  payrollWeekLines PayrollWeekLine[]

  @@index([isActive, position])
  @@index([managerAccountId])
}

model CashRegister {
  id                Int      @id @default(autoincrement())
  storeId           Int
  name              String   @db.VarChar(80)
  code              String?  @db.VarChar(20)
  emissionPointCode String   @default("001") @db.VarChar(3)
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch     Branch      @relation(fields: [storeId], references: [id])
  cashShifts CashShift[]
  sales      Sale[]

  @@index([storeId])
}

model BranchShelf {
  id        Int      @id @default(autoincrement())
  storeId   Int
  name      String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch         Branch         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branchProducts BranchProduct[]

  @@index([storeId])
}

model CashShift {
  id                   Int             @id @default(autoincrement())
  accountId            Int
  userId               Int
  storeId              Int?
  activeCashRegisterId Int?
  establishmentCode    String?         @db.VarChar(3)
  emissionPointCode    String?         @db.VarChar(3)
  status               CashShiftStatus @default(open)
  openedAt             DateTime
  closedAt             DateTime?
  openingCashCounts    Json
  openingCashTotal     Float           @default(0)
  closingCashCounts    Json?
  closingCashTotal     Float?
  expectedCashTotal    Float?
  cashDifference       Float?
  salesCashTotal       Float?
  salesTransferTotal   Float?
  salesCardTotal       Float?
  salesTotal           Float?
  cashOutTotal         Float?
  cashInTotal          Float?
  openingNotes         String?         @db.Text
  closingNotes         String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  person       Person        @relation(fields: [userId], references: [id])
  branch       Branch?       @relation(fields: [storeId], references: [id])
  cashRegister CashRegister? @relation(fields: [activeCashRegisterId], references: [id])
  movements    CashShiftMovement[]
  sales        Sale[]

  @@index([status, openedAt])
  @@index([storeId, openedAt])
}

model CashShiftMovement {
  id                  Int      @id @default(autoincrement())
  shiftId             Int
  accountId           Int?
  userId              Int
  direction           String
  category            String?
  amount              Float
  concept             String?
  notes               String?  @db.Text
  productId           Int?
  quantity            Float?
  inventoryMovementId Int?
  expenseId           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shift  CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  person Person    @relation(fields: [userId], references: [id])

  @@index([shiftId])
}

model BranchStock {
  id          Int      @id @default(autoincrement())
  storeId     Int
  productId   Int
  quantity    Float    @default(0)
  exhibidorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch  Branch  @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@index([storeId, quantity])
}

model BranchProduct {
  id          Int      @id @default(autoincrement())
  storeId     Int
  productId   Int
  isActive    Boolean  @default(true)
  exhibidorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch  Branch       @relation(fields: [storeId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  shelf   BranchShelf? @relation(fields: [exhibidorId], references: [id], onDelete: SetNull)

  @@unique([storeId, productId])
}

// ——— Clientes / ventas POS (EdDeli Customer, Order*) ———

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  firstName      String?  @db.VarChar(120)
  secondName     String?  @db.VarChar(120)
  firstLastName  String?  @db.VarChar(120)
  secondLastName String?  @db.VarChar(120)
  identType      String?  @default("05") @db.VarChar(2)
  cedula         String?  @db.VarChar(32)
  phone          String?
  address        String?
  email          String?
  /** Acceso portal cliente (hash). Null = sin cuenta pública. */
  password       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales         Sale[]
  itemGroups    ItemGroup[]
  financePayments FinancePayment[]
  appointments  Appointment[]
  loyalty       CustomerLoyalty?
  pointTransactions PointTransaction[]
  electronicInvoices ElectronicInvoice[]
}

/** Venta / pedido POS (EdDeli Order). */
model Sale {
  id               Int        @id @default(autoincrement())
  customerId       Int
  status           SaleStatus @default(pendiente)
  notes            String?    @db.Text
  shiftId          Int?
  cashRegisterId   Int?
  sellerAccountId  Int?
  paymentMethod    String?    @db.VarChar(40)
  paidAt           DateTime?
  documentType     String?    @db.VarChar(30)
  date             DateTime   @default(now())
  financeIncomeId  Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  shift        CashShift?    @relation(fields: [shiftId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  seller       Account?      @relation("SaleSeller", fields: [sellerAccountId], references: [id])
  lines        SaleLine[]
  installments SalePaymentInstallment[]
  electronicInvoices ElectronicInvoice[]

  @@index([customerId, date])
  @@index([status, date])
  @@index([shiftId])
}

model SaleLine {
  id               Int       @id @default(autoincrement())
  orderId          Int
  productId        Int
  quantity         Float
  price            Float
  soldQty          Float     @default(0)
  damagedQty       Float     @default(0)
  giftQty          Float     @default(0)
  replacedQty      Float     @default(0)
  deliveredAt      DateTime?
  deliveredStoreId Int?
  paidAt           DateTime?
  packKey          String?   @db.VarChar(64)
  packName         String?   @db.VarChar(120)
  lotCode          String?   @db.VarChar(80)
  expiresAt        DateTime? @db.Date
  manufacturedAt   DateTime? @db.Date

  sale             Sale    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])
  deliveredBranch  Branch? @relation("SaleLineDeliveredBranch", fields: [deliveredStoreId], references: [id])
  itemGroupItems   ItemGroupItem[]

  @@index([orderId])
  @@index([productId])
}

model SalePaymentInstallment {
  id                 Int       @id @default(autoincrement())
  orderId            Int
  sequence           Int       @default(1)
  /** null = crédito abierto sin fecha de pago */
  dueDate            DateTime? @db.Date
  amount             Float
  notes              String?
  reminderEnabled    Boolean   @default(false)
  reminderDaysBefore Int?      @db.TinyInt
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sale Sale @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ——— Proveedores / compras (EdDeli Supplier*) ———

model Supplier {
  id                     Int      @id @default(autoincrement())
  name                   String   @db.VarChar(150)
  tradeName              String?  @db.VarChar(150)
  identType              String?  @default("04") @db.VarChar(2)
  identNumber            String?  @db.VarChar(32)
  category               String?  @db.VarChar(80)
  contactName            String?  @db.VarChar(120)
  contactRole            String?  @db.VarChar(80)
  phone                  String?  @db.VarChar(40)
  whatsapp               String?  @db.VarChar(40)
  email                  String?  @db.VarChar(120)
  invoiceEmail           String?  @db.VarChar(120)
  website                String?  @db.VarChar(200)
  address                String?  @db.VarChar(250)
  city                   String?  @db.VarChar(80)
  province               String?  @db.VarChar(80)
  bankName               String?
  bankAccountType        String?
  bankAccountNumber      String?
  paymentTermDays        Int?
  preferredPaymentMethod String?
  notes                  String?  @db.Text
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  productCodes   SupplierProductCode[]
  packs          SupplierPack[]
  payments       SupplierOrderPayment[]
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  supplierId      Int
  date            DateTime            @default(now())
  notes           String?             @db.Text
  status          PurchaseOrderStatus @default(pendiente)
  receivedAt      DateTime?
  receivedStoreId Int?
  paidAt          DateTime?
  paymentMethod   String?
  financeExpenseId Int?
  invoiceNumber   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  receivedBranch Branch?              @relation("PurchaseReceivedBranch", fields: [receivedStoreId], references: [id])
  lines          PurchaseOrderLine[]
  installments   PurchaseOrderPaymentInstallment[]
  payments       SupplierOrderPayment[]
  packItems      SupplierPackItem[]

  @@index([supplierId, date])
  @@index([status, date])
}

model PurchaseOrderLine {
  id               Int       @id @default(autoincrement())
  orderId          Int
  productId        Int
  quantity         Float
  unitPrice        Float     @default(0)
  discount         Float     @default(0)
  taxRate          Float     @default(0)
  packKey          String?
  packName         String?
  lotCode          String?
  expiresAt        DateTime? @db.Date
  manufacturedAt   DateTime? @db.Date
  inventoryBatchId Int?

  purchaseOrder PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  packItems     SupplierPackItem[]

  @@index([orderId])
}

model PurchaseOrderPaymentInstallment {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  sequence           Int      @default(1)
  dueDate            DateTime @db.Date
  amount             Float
  notes              String?
  reminderEnabled    Boolean  @default(false)
  reminderDaysBefore Int?     @db.TinyInt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SupplierProductCode {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  productId    Int
  supplierCode String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierCode])
}

model SupplierPack {
  id             Int      @id @default(autoincrement())
  supplierId     Int
  concept        String?
  packAmount     Float    @default(0)
  kind           String?
  memberOrderIds Json?
  status         String?
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    SupplierPackItem[]
  payments SupplierOrderPayment[]
}

model SupplierPackItem {
  id                    Int    @id @default(autoincrement())
  packId                Int
  supplierOrderId       Int?
  supplierOrderItemId   Int    @unique
  quantity              Float  @default(0)
  allocatedUnitPrice    Float  @default(0)
  previousUnitPrice     Float?
  allocatedLineTotal    Float  @default(0)

  pack              SupplierPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder?    @relation(fields: [supplierOrderId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [supplierOrderItemId], references: [id])
}

model SupplierOrderPayment {
  id              Int           @id @default(autoincrement())
  supplierOrderId Int?
  supplierId      Int
  supplierPackId  Int?
  date            DateTime      @default(now())
  amount          Float
  method          String?       @default("efectivo")
  note            String?
  status          PaymentStatus @default(completed)
  expenseId       Int?
  createdBy       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchaseOrder PurchaseOrder? @relation(fields: [supplierOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  pack          SupplierPack?  @relation(fields: [supplierPackId], references: [id])
}

// ——— Finanzas ———

model Expense {
  id               Int           @id @default(autoincrement())
  date             DateTime      @default(now())
  amount           Float
  concept          String?
  category         String?
  referenceId      Int?
  referenceType    String?
  status           FinanceStatus @default(paid)
  counterpartyName String?
  createdBy        Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator Account? @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([category, date])
}

model Income {
  id               Int           @id @default(autoincrement())
  date             DateTime      @default(now())
  amount           Float
  concept          String?
  category         String?
  referenceId      Int?
  referenceType    String?
  status           FinanceStatus @default(paid)
  counterpartyName String?
  createdBy        Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator Account? @relation("IncomeCreator", fields: [createdBy], references: [id])

  @@index([date])
}

model ItemGroup {
  id          Int      @id @default(autoincrement())
  customerId  Int
  concept     String?
  status      String   @default("open")
  totalAmount Float    @default(0)
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  items    ItemGroupItem[]
  payments FinancePayment[]
}

model ItemGroupItem {
  id          Int      @id @default(autoincrement())
  groupId     Int
  orderItemId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group    ItemGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  saleLine SaleLine  @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId])
}

/** Cobro a cliente por grupo de ítems (EdDeli Payment). */
model FinancePayment {
  id         Int           @id @default(autoincrement())
  customerId Int
  groupId    Int
  date       DateTime      @default(now())
  amount     Float
  method     String        @default("efectivo")
  note       String?
  status     PaymentStatus @default(completed)
  createdBy  Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  group    ItemGroup @relation(fields: [groupId], references: [id])
  creator  Account   @relation("PaymentCreator", fields: [createdBy], references: [id])
}

model RecurringExpenseTemplate {
  id               Int      @id @default(autoincrement())
  storeId          Int?
  name             String
  category         String?
  amountType       String?
  frequency        String?
  baseAmount       Float    @default(0)
  dueDayOfMonth    Int?
  dueMonth         Int?
  provider         String?
  note             String?  @db.Text
  reminderEnabled  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdBy        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch       Branch?                      @relation(fields: [storeId], references: [id])
  occurrences  RecurringExpenseOccurrence[]
}

model RecurringExpenseOccurrence {
  id            Int      @id @default(autoincrement())
  templateId    Int
  periodKey     String
  amount        Float    @default(0)
  status        String   @default("pending")
  expenseId     Int?
  paidDate      DateTime?
  dueDate       DateTime?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template RecurringExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodKey])
}

model FinancialObligation {
  id                    Int      @id @default(autoincrement())
  direction             String
  partyType             String?
  customerId            Int?
  partyName             String?
  concept               String?
  originalAmount        Float    @default(0)
  openDate              DateTime?
  dueDate               DateTime?
  status                String?
  initialFinanceType    String?
  initialFinanceId      Int?
  note                  String?  @db.Text
  createdBy             Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payments ObligationPayment[]
}

model ObligationPayment {
  id           Int      @id @default(autoincrement())
  obligationId Int
  date         DateTime @default(now())
  amount       Float
  method       String?
  note         String?
  financeType  String?
  financeId    Int?
  status       String?
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  obligation FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
}

model DocumentAttachment {
  id           Int      @id @default(autoincrement())
  entityType   String
  entityId     Int
  batchKey     String?
  filePath     String
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  label        String?
  invoiceNumber String?
  uploadedBy   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entityType, entityId])
}

// ——— Canal / marketing / precios ———

model HomeProduct {
  id            Int      @id @default(autoincrement())
  productId     Int?
  name          String
  description   String?  @db.Text
  imageUrl      String?
  priceOverride Float?
  section       String?
  badge         String?
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model CatalogEntry {
  id            Int      @id @default(autoincrement())
  productId     Int
  section       String
  storeId       Int?
  title         String?
  subtitle      String?
  imageUrl      String?
  badge         String?
  position      Int      @default(0)
  priceOverride Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, section, storeId])
}

model ProductCompareGroup {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ProductCompareGroupItem[]
}

model ProductCompareGroupItem {
  id        Int      @id @default(autoincrement())
  groupId   Int
  productId Int
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ProductCompareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, productId])
}

model PricingTierGroup {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?  @db.Text
  categoryId   Int?
  packageTiers Json?
  productIds   Json?
  isActive     Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
}

// ——— Tareas ———

model TaskPlan {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?   @db.Text
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  status          String?   @default("draft")
  createdByUserId Int?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items TaskItem[]
}

model TaskItem {
  id               Int              @id @default(autoincrement())
  planId           Int
  title            String
  assignedUserId   Int?
  status           TaskItemStatus   @default(todo)
  priority         TaskItemPriority @default(medium)
  dueDate          DateTime?        @db.Date
  actionType       String?
  actionPayload    Json?
  checkedAt        DateTime?
  checkedByUserId  Int?
  resultNote       String?          @db.Text
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  plan      TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignee  Person?  @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  checkedBy Person?  @relation("TaskChecker", fields: [checkedByUserId], references: [id])

  @@index([planId, status])
}

// ——— Sistema ———

model License {
  id             Int       @id @default(autoincrement())
  name           String?   @db.Text
  token          String?   @db.Text
  time           String?   @db.Text
  valide         Int       @default(1)
  dateCreation   DateTime? @db.Date
  dateUse        DateTime? @db.Date
  dateExpiration DateTime? @db.Date
}

model SystemLog {
  id          Int       @id @default(autoincrement())
  httpMethod  String?   @db.Text
  action      String?   @db.Text
  endPoint    String?   @db.Text
  description String?   @db.Text
  system      String?   @db.Text
  date        DateTime  @default(now())
}

model AppSettings {
  id                           Int      @id @default(1)
  name                         String   @db.VarChar(255)
  alias                        String   @db.VarChar(80)
  version                      String   @default("1.0.0") @db.VarChar(32)
  description                  String?  @db.Text
  author                       String?  @db.VarChar(120)
  logoPath                     String?  @db.VarChar(255)
  iconPath                     String?  @db.VarChar(255)
  phone                        String?  @db.VarChar(40)
  socialWhatsapp               String?  @db.VarChar(255)
  socialFacebook               String?  @db.VarChar(255)
  socialInstagram              String?  @db.VarChar(255)
  socialTiktok                 String?  @db.VarChar(255)
  socialEmail                  String?  @db.VarChar(120)
  mediaFolderPrefix            String   @default("sistema") @db.VarChar(80)
  cajaQuickCategoryMatch       String?  @db.VarChar(80)
  walkInCustomerLabel          String   @default("Consumidor Final") @db.VarChar(80)
  timezone                     String   @default("America/Guayaquil") @db.VarChar(64)
  showPublicCatalog            Boolean  @default(true)
  showPublicStoresPropia       Boolean  @default(true)
  showPublicStoresVitrina      Boolean  @default(true)
  multiStockEnabled            Boolean  @default(true)
  showProductCostInSelect      Boolean  @default(false)
  moneyDisplayDecimals         Int      @default(2)
  moneyRoundingMode            String   @default("up") @db.VarChar(16)
  ordersAllowDeliverStockAdjust Boolean @default(true)
  financeAllowAdminCorrections Boolean  @default(true)
  cajaAllowCreateProductFromSelect Boolean @default(true)
  cajaAllowEditProductFromCart Boolean @default(true)
  cajaSuggestUpdateProductPrice Boolean @default(true)
  receiptDetailSettings        String?  @db.Text
  themePalette                 String?  @db.Text
  accentColor                  String   @default("#D4AF37")
  successColor                 String   @default("#22C55E")
  warningColor                 String   @default("#F0B429")
  dangerColor                  String   @default("#F04438")
  operationFlags               Json?
  updatedAt                    DateTime @updatedAt
  createdAt                    DateTime @default(now())
}

model AppEntitlement {
  id        Int               @id @default(1)
  payload   Json
  source    String            @default("local") @db.VarChar(40)
  syncedAt  DateTime?         @map("synced_at")
  status    EntitlementStatus @default(gestor_push)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SriBillingSettings {
  id                         Int       @id @default(1)
  enabled                    Boolean   @default(false)
  environment                String    @default("pruebas")
  ruc                        String?
  legalName                  String?
  tradeName                  String?
  matrixAddress              String?   @db.Text
  establishmentAddress       String?   @db.Text
  establishmentCode          String    @default("001") @db.VarChar(3)
  emissionPointCode          String    @default("001") @db.VarChar(3)
  phone                      String?
  email                      String?
  accountingRequired         Boolean   @default(true)
  specialTaxpayerResolution  String?
  taxRegime                  String?
  nextInvoiceSequential      Int       @default(1)
  certificateRelativePath    String?
  certificatePasswordEnc     String?   @db.Text
  certificateFileName        String?
  certificateUploadedAt      DateTime?
  notes                      String?   @db.Text
  enableSendInvoiceEmail     Boolean   @default(false)
  smtpHost                   String?
  smtpPort                   Int?
  smtpSecure                 Boolean   @default(true)
  smtpUser                   String?
  smtpPassEnc                String?   @db.Text
  smtpFrom                   String?
  invoiceEmailDailyLimit     Int?
  invoiceEmailsSentDate      DateTime? @db.Date
  invoiceEmailsSentCount     Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model ElectronicInvoice {
  id                  Int                      @id @default(autoincrement())
  environment         String                   @default("pruebas")
  documentType        String                   @default("factura")
  establishmentCode   String?
  emissionPointCode   String?
  sequential          String?
  accessKey           String?                  @unique
  authorizationNumber String?
  authorizationDate   DateTime?
  status              ElectronicInvoiceStatus  @default(draft)
  customerId          Int?
  orderId             Int?
  branchId            Int?
  buyerName           String?
  buyerIdentification String?
  buyerIdentificationType String?              @default("05")
  buyerAddress        String?
  buyerEmail          String?
  buyerPhone          String?
  subtotal            Float                    @default(0)
  ivaAmount           Float                    @default(0)
  iceTotal            Float                    @default(0)
  total               Float                    @default(0)
  currency            String                   @default("USD")
  lines               Json?
  xmlPath             String?
  pdfPath             String?
  payloadJson         Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  sale     Sale?     @relation(fields: [orderId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])

  @@index([status, createdAt])
}

// ============================================================
// Extras Scheduly: Agenda + Servicios (+ fidelización ligada)
// ============================================================

model Service {
  id              Int    @id @default(autoincrement())
  name            String
  price           Float
  durationMinutes Int    @default(30)
  commissionPct   Float  @default(15)
  isActive        Boolean @default(true)

  appointmentServices AppointmentService[]
  branches            ServiceBranch[]
  rewards             Reward[]
}

model Appointment {
  id              Int               @id @default(autoincrement())
  title           String
  description     String            @default("")
  customerId      Int
  userId          Int
  appointmentDate DateTime
  status          AppointmentStatus
  reminderSent    String            @default("none")
  stockDeducted   Boolean           @default(false)
  branchId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  staff    Person   @relation("AppointmentStaff", fields: [userId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  services AppointmentService[]
  products AppointmentProduct[]
  payment  AppointmentPayment?
  commission CommissionRecord?

  @@index([appointmentDate])
  @@index([branchId, appointmentDate])
  @@index([userId, appointmentDate])
  @@index([status, appointmentDate])
  @@index([customerId])
}

model AppointmentService {
  appointmentId Int
  serviceId     Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model AppointmentProduct {
  appointmentId Int
  productId     Int
  quantity      Int @default(1)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@id([appointmentId, productId])
}

model AppointmentPayment {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  amount        Float
  method        String
  paidAt        DateTime @default(now())
  notes         String   @default("")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model ServiceBranch {
  serviceId     Int
  branchId      Int
  isActive      Boolean @default(true)
  priceOverride Float?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
}

model ServicePromotion {
  id            Int       @id @default(autoincrement())
  name          String
  description   String    @db.Text
  discountPct   Float?
  discountFixed Float?
  comboLabel    String?
  startsAt      DateTime
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  serviceIds    Json
  branchIds     Json
  /** Días de semana activos (0=dom … 6=sáb). Null/[] = todos los días del rango. */
  weekdays      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LoyaltySettings {
  id                   Int      @id @default(1)
  pointsPerAppointment Int      @default(10)
  pointsPerAmount      Float    @default(1)
  amountUnit           Float    @default(10)
  silverThreshold      Int      @default(100)
  goldThreshold        Int      @default(300)
  updatedAt            DateTime @updatedAt
}

model CustomerLoyalty {
  customerId Int      @id
  points     Int      @default(0)
  tier       String   @default("bronze")
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PointTransaction {
  id            Int      @id @default(autoincrement())
  customerId    Int
  points        Int
  reason        String
  appointmentId Int?
  rewardId      Int?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   Reward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

model Reward {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  pointsCost  Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  serviceId   Int?
  productId   Int?
  discountPct Float?
  createdAt   DateTime @default(now())

  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  redemptions PointTransaction[]
}

model FeedPost {
  id        Int       @id @default(autoincrement())
  title     String
  body      String    @db.Text
  type      String    @default("news")
  imageUrl  String?
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

model CommissionRecord {
  id            Int       @id @default(autoincrement())
  userId        Int
  appointmentId Int       @unique
  baseAmount    Float
  ratePct       Float
  amount        Float
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, settledAt])
}

/** Medios / bancos del cuadre (sin eliminación dura: isActive=false). */
model PaymentMedium {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  code      String?  @unique @db.VarChar(40)
  kind      String   @default("other") @db.VarChar(40)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashCloseLines CashCloseLine[]

  @@index([isActive, position])
}

/** Cuadre diario de caja por sucursal y medio de pago. */
model CashClose {
  id            Int      @id @default(autoincrement())
  branchId      Int
  closeDate     DateTime @db.Date
  expensesTotal Float    @default(0)
  notes         String?  @db.Text
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch    Branch          @relation(fields: [branchId], references: [id])
  createdBy Account         @relation("CashCloseCreator", fields: [createdById], references: [id])
  lines     CashCloseLine[]

  @@unique([branchId, closeDate])
  @@index([closeDate])
}

model CashCloseLine {
  id              Int   @id @default(autoincrement())
  cashCloseId     Int
  paymentMediumId Int
  amount          Float @default(0)

  cashClose     CashClose     @relation(fields: [cashCloseId], references: [id], onDelete: Cascade)
  paymentMedium PaymentMedium @relation(fields: [paymentMediumId], references: [id])

  @@unique([cashCloseId, paymentMediumId])
}

/** Liquidación / pago semanal (firma = confirmación del empleado). */
model PayrollWeek {
  id          Int      @id @default(autoincrement())
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /** draft | published | closed */
  status      String   @default("draft") @db.VarChar(20)
  notes       String?  @db.Text
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Account           @relation("PayrollWeekCreator", fields: [createdById], references: [id])
  lines     PayrollWeekLine[]

  @@unique([periodStart, periodEnd])
  @@index([status, periodStart])
}

model PayrollWeekLine {
  id                   Int       @id @default(autoincrement())
  payrollWeekId        Int
  accountId            Int
  branchId             Int?
  /** Se · comisión servicios (auto + editable) */
  producedAmount       Float     @default(0)
  /** Pr · comisión productos (auto + editable) */
  salesAmount          Float     @default(0)
  vouchersAmount       Float     @default(0)
  cafeteriaAmount      Float     @default(0)
  finesAmount          Float     @default(0)
  discountsAmount      Float     @default(0)
  additionalAmount     Float     @default(0)
  totalAmount          Float     @default(0)
  notes                String?   @db.Text
  employeeConfirmedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payrollWeek PayrollWeek @relation(fields: [payrollWeekId], references: [id], onDelete: Cascade)
  account     Account     @relation("PayrollWeekLineEmployee", fields: [accountId], references: [id])
  branch      Branch?     @relation(fields: [branchId], references: [id])

  @@unique([payrollWeekId, accountId])
  @@index([accountId, employeeConfirmedAt])
}
